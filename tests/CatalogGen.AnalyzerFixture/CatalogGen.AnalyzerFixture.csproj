<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An analyzer assembly built the way a shipped one is built, for the single test that cannot be
    written without a real one.

    DescriptorReaderTests already exercises the reader's refusals with fixtures that live inside the
    test assembly, which is enough while what is being reproduced is a type that throws. It is not
    enough for a type that cannot be LOADED: the failure depends on the assembly's own references
    being unresolvable in the worker, and a type compiled into a net10.0 test assembly resolves
    everything it names by construction. So this is a separate project, and netstandard2.0 is not a
    detail — it is the whole mechanism. IAsyncEnumerable<T> lives in the runtime on net10.0 and in
    Microsoft.Bcl.AsyncInterfaces on netstandard2.0, and only the second spelling puts that
    assembly's IDENTITY into the compiled reference table, which is what the worker then has to
    resolve.

    It ships nothing and joins no release train. It is built because CatalogGen.UnitTests references
    it, and the only file that travels is its own assembly — see the copy target there, which is
    deliberate rather than incidental.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CatalogGen.AnalyzerFixture</AssemblyName>
    <RootNamespace>CatalogGen.AnalyzerFixture</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      RS2008 arrives transitively with Roslyn and asks that FIX0001 be recorded in
      AnalyzerReleases.*.md. src/DiagnosticCatalog.Analyzers answers it with those two files, and
      that is the right answer THERE: the rule exists so a diagnostic somebody ships is never
      shipped unrecorded. FIX0001 is shipped to nobody. It has no release to track, and writing it a
      release history would be recording a fact that is not one — so the rule is turned off here
      rather than satisfied with a fiction. Everything else the authoring rules check stays on.
    -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <!--
    PrivateAssets on BOTH, and on the facade it is load-bearing rather than tidy.

    A ProjectReference flows its package dependencies to whoever references it. Letting
    Microsoft.Bcl.AsyncInterfaces flow would land the facade in CatalogGen.UnitTests' output — which
    is exactly where the worker is bundled, and therefore exactly where the test needs it NOT to be
    until the worker deploys it on purpose. Without this, the test would pass against the unfixed
    worker and prove nothing at all.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" PrivateAssets="all" />
  </ItemGroup>

</Project>
