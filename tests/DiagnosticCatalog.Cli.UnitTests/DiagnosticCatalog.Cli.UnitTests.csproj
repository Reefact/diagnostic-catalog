<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately does NOT import build/Net472TestFloor.props. That file enrols a project in the
    .NET Framework 4.7.2 floor, which exists to prove that a SHIPPED netstandard2.0 assembly behaves
    on the real .NET Framework CLR. `dcat` is a .NET tool floored at net8.0 (ADR-0017), not a
    netstandard2.0 library, so there is no such assembly here and the floor would be running a
    command-line tool on a runtime it never meets. See CONTRIBUTING.md, "The .NET Framework floor".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>DiagnosticCatalog.Cli.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!--
      For the catalogue fixtures the inspect verbs are pointed at. `dcat list` and `dcat explain`
      read a compiled catalogue, so exercising them needs one on disk, and the shapes that matter —
      a retired rule, a rule with a help link and one without, an assembly carrying no rules at all
      — are not all present in any catalogue this repository happens to ship.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!--
    LINKED SOURCE, the same call BundleDescriptorWorker's sibling makes in CatalogGen.Worker: the
    fixture builder is one file, compiled into both suites, so the catalogue the engine's tests read
    and the catalogue the tool's tests read cannot drift into being two different things.
  -->
  <ItemGroup>
    <Compile Include="..\CatalogGen.UnitTests\CatalogueFixture.cs" Link="CatalogueFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DiagnosticCatalog.Cli\DiagnosticCatalog.Cli.csproj" />
  </ItemGroup>

  <!--
    The descriptor worker, beside this suite's own output. `generate` and `validate` read descriptors
    by SPAWNING it, so a test that runs either of them to completion needs it here — the copy that
    sits beside dcat.dll is in another directory, and DescriptorReader looks in AppContext.BaseDirectory.
    Without this the reads return null, both commands answer 1, and the failure names the packaging
    rather than the test. CatalogGen.UnitTests imports it for the same reason.
  -->
  <Import Project="..\..\build\BundleDescriptorWorker.props" />

</Project>
