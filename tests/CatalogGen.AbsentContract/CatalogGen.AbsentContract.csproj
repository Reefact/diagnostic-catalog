<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An assembly whose only job is to be MISSING at read time.

    CatalogGen.PartialLoadFixture implements the interface below, and no folder the tests read from
    ever holds this assembly — so that one type cannot be materialised there, which is the whole
    fixture. Upstream the same shape comes from a Roslyn interface that gained a member: a type the
    process was never going to load, in an assembly that is otherwise perfectly readable.

    It references NOTHING, and that is the point rather than minimalism for its own sake. Borrowing
    the interface from CatalogGen.AnalyzerFixture instead made MSBuild unify
    System.Threading.Tasks.Extensions across the two and warn (MSB3277) — a real version conflict,
    which CI turns into an error, reported against a fixture that has no opinion about async at all.
    An assembly with no references cannot conflict with anything.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>CatalogGen.AbsentContract</AssemblyName>
    <RootNamespace>CatalogGen.AbsentContract</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
