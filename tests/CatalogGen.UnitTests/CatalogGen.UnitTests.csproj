<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately does NOT import build/Net472TestFloor.props. That file enrols a project in the
    .NET Framework 4.7.2 floor, which exists to prove that a SHIPPED netstandard2.0 assembly behaves
    on the real .NET Framework CLR. CatalogGen ships nothing and targets net10.0 only, so there is
    no such assembly here and the floor would be running a build-time tool on a runtime it never
    meets. See CONTRIBUTING.md, "The .NET Framework floor".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!--
      For the deliberately unconstructible DiagnosticAnalyzer that DescriptorReaderTests hands the
      worker. It used to arrive transitively from the engine; the engine no longer references Roslyn
      at all, because reading descriptors — the only thing that needed it — moved into the worker.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!--
    The real generated catalogues are copied beside the test binary. The round-trip test reads one
    back with the parser, regenerates it with the emitter, and asserts the bytes match — which is a
    stronger check than any hand-written fixture, because the input is exactly what ships. Copying
    rather than resolving a repository path at run time keeps it working under the deterministic CI
    build, which rewrites compile-time source paths.
  -->
  <ItemGroup>
    <!--
      bin/ and obj/ are excluded because ".g.cs" is not only a catalogue's extension: it is what the
      SDK names its own generated sources too, and one of those under src/ is swept up by a glob that
      only says "*.g.cs". The theory below then runs over a file that is not a catalogue and fails
      for the right reason with the wrong cause. It went unnoticed while no project under src/
      produced any — enabling ImplicitUsings on one is all it took.
    -->
    <Content Include="..\..\src\**\*.g.cs"
             Exclude="..\..\src\**\bin\**\*.g.cs;..\..\src\**\obj\**\*.g.cs"
             Link="catalogs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The real manifest and the schema beside it, for the tests that hold the two to the same contract.
    Copied rather than reached for by repository path, for the reason above: the deterministic CI
    build rewrites compile-time source paths, so a path computed from one resolves to nothing there.
  -->
  <ItemGroup>
    <Content Include="..\..\eng\catalogs.json;..\..\eng\catalogs.schema.json"
             Link="manifest\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\eng\CatalogGen\CatalogGen.csproj" />
  </ItemGroup>

  <!-- DescriptorReader spawns the worker, so the tests that exercise it need one beside them. -->
  <Import Project="..\..\build\BundleDescriptorWorker.props" />

</Project>
