<Project>

  <!-- Enable Central Package Management. Kept first, and as the ONLY place this property name appears in the
       file, so a static analyzer (e.g. OpenSSF Scorecard's Pinned-Dependencies parser) reads the intended
       "true" and never a value mentioned in prose below. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Central Package Management (CPM). One source of truth for every NuGet version in the repository: projects
    declare <PackageReference Include="..." /> WITHOUT a Version, and the version is resolved from the matching
    <PackageVersion> below. This keeps versions consistent across the projects and makes the `dotnet restore`
    steps in CI reproducible — which is also what OpenSSF Scorecard's Pinned-Dependencies check rewards (an
    unpinned restore otherwise caps that check below 10, via "nugetCommand not pinned").
  -->

  <ItemGroup>
    <!-- The foundation, consumed by the catalogue projects as a PACKAGE rather than a project reference.
         They ride different release trains, and packing a project that referenced another train's project
         would stamp a dependency on a version that was never published (ADR-0007). This line is therefore
         the version every published catalogue declares it needs, and bumping it is a deliberate act rather
         than a side effect of the foundation moving. -->
    <PackageVersion Include="DiagnosticCatalog" Version="0.1.0" />
    <!-- Consumed by the .NET Framework 4.7.2 floor: build/Net472TestFloor.props adds this reference on the
         net472 inner build, version-less, so the version has to resolve from here. Reference assemblies only
         (PrivateAssets=all), so net472 compiles on a box without the 4.7.2 targeting pack installed. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- Drives the "XPlat Code Coverage" collector configured in coverage.runsettings; every test project
         references it. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- xUnit.net v3 is the test framework. v3 test projects are executables on .NET Framework,
         which build/Net472TestFloor.props handles for the projects that join the floor. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Embeds the SPDX SBOM in every published package. Referenced from Directory.Build.targets for any
         project declaring a <ReleaseTrain>, version-less, so the version has to resolve from here. -->
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
    <!-- Guards the foundation's public API surface: RS0016/RS0017 turn a renamed or added
         public member into a build error, which is what makes §23's "renaming the attribute is
         a major version" a mechanical check rather than a review habit. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- The authoring analyzers for analyzer authors (RS1xxx, RS2xxx): they check that a
         DiagnosticAnalyzer is well formed and that every declared id appears in AnalyzerReleases.*.md.
         Build-time only (PrivateAssets=all) and NOT part of the load contract, so unlike
         Microsoft.CodeAnalysis.CSharp this one is free to track the newest version. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <!-- The Sonar C# rules, so the build reports what SonarQube Cloud would report instead of the
         dashboard being the first place anyone meets them (ADR-0021). Which rules are ON comes from
         build/sonar-profile.globalconfig, generated from the server's quality profile — the package's
         own default set is narrower. Build-time only (PrivateAssets=all).
         Version drift is the cost: this pin follows SonarSource's release line while the profile
         follows the server's, so a bump can introduce a rule the report does not have yet. The weekly
         sonar-profile workflow is what makes the two visible to each other. -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.31.0.145097" />
    <!-- Used by eng/CatalogGen to resolve DiagnosticAnalyzer and DiagnosticDescriptor when it
         loads an upstream analyzer assembly reflectively. Build-time tooling only: the shipped
         catalogs carry no Roslyn dependency. Workspaces is needed because some upstream
         analyzers derive from types that reference it. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <!-- The command tree, argument parsing and help output of the `dcat` tool. Chosen over a
         hand-rolled parser because the tool is published: the parser it replaced read arguments in
         pairs, which made a switch left dangling at the end of a command line neither applied nor
         reported, and it offered no help switch at all. Both are acceptable in build tooling nobody
         else runs, and neither is acceptable in a tool somebody installs. -->
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <!-- NuGet's own client, used by the generator to resolve and download a package from the sources
         the machine is actually configured with rather than from a hardcoded api.nuget.org. The
         reason to take the dependency rather than keep hand-rolling HTTP is that everything below
         the flat-container call is what this library exists for: the NuGet.config hierarchy
         (machine, user, and every folder up from the working directory), service-index discovery,
         and credentials — including the encrypted and provider-supplied kinds, which cannot be read
         by hand at all. Version 7.6.0 and not 6.14.0: the latter carries advisory
         GHSA-g4vj-cjjj-v7hg. -->
    <PackageVersion Include="NuGet.Protocol" Version="7.6.0" />
    <!-- Reflection-only loading, so `dcat list` and `dcat explain` can read a compiled catalogue
         without executing any of it. A catalogue declares everything it publishes as metadata
         constants, so nothing has to run for them to be read — and a tool that loaded a stranger's
         assembly into its own process to answer a question about its contents would be taking a
         licence it does not need. -->
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

</Project>
