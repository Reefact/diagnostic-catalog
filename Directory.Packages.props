<Project>

  <!-- Enable Central Package Management. Kept first, and as the ONLY place this property name appears in the
       file, so a static analyzer (e.g. OpenSSF Scorecard's Pinned-Dependencies parser) reads the intended
       "true" and never a value mentioned in prose below. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Central Package Management (CPM). One source of truth for every NuGet version in the repository: projects
    declare <PackageReference Include="..." /> WITHOUT a Version, and the version is resolved from the matching
    <PackageVersion> below. This keeps versions consistent across the projects and makes the `dotnet restore`
    steps in CI reproducible — which is also what OpenSSF Scorecard's Pinned-Dependencies check rewards (an
    unpinned restore otherwise caps that check below 10, via "nugetCommand not pinned").
  -->

  <ItemGroup>
    <!-- The foundation, consumed by the catalogue projects as a PACKAGE rather than a project reference.
         They ride different release trains, and packing a project that referenced another train's project
         would stamp a dependency on a version that was never published (ADR-0007). This line is therefore
         the version every published catalogue declares it needs, and bumping it is a deliberate act rather
         than a side effect of the foundation moving. -->
    <PackageVersion Include="DiagnosticCatalog" Version="0.1.0" />
    <!-- Consumed by the .NET Framework 4.7.2 floor: build/Net472TestFloor.props adds this reference on the
         net472 inner build, version-less, so the version has to resolve from here. Reference assemblies only
         (PrivateAssets=all), so net472 compiles on a box without the 4.7.2 targeting pack installed. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- Drives the "XPlat Code Coverage" collector configured in coverage.runsettings; every test project
         references it. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- xUnit.net v3 is the test framework. v3 test projects are executables on .NET Framework,
         which build/Net472TestFloor.props handles for the projects that join the floor. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Embeds the SPDX SBOM in every published package. Referenced from Directory.Build.targets for any
         project declaring a <ReleaseTrain>, version-less, so the version has to resolve from here. -->
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
    <!-- Guards the foundation's public API surface: RS0016/RS0017 turn a renamed or added
         public member into a build error, which is what makes §23's "renaming the attribute is
         a major version" a mechanical check rather than a review habit. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- Used by eng/CatalogGen to resolve DiagnosticAnalyzer and DiagnosticDescriptor when it
         loads an upstream analyzer assembly reflectively. Build-time tooling only: the shipped
         catalogs carry no Roslyn dependency. Workspaces is needed because some upstream
         analyzers derive from types that reference it. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

</Project>
