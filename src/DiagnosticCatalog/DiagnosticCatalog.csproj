<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>DiagnosticCatalog</AssemblyName>
    <RootNamespace>DiagnosticCatalog</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The foundation ships on the lib train. Declaring it here is the whole membership
    (Directory.Build.targets), and it is also what makes the project packable and gives it
    an embedded SBOM.
  -->
  <PropertyGroup>
    <ReleaseTrain>lib</ReleaseTrain>
  </PropertyGroup>

  <!--
    NOT a development dependency. Per docs §16.1 this package must flow to the consumers of
    a catalog: they need the attribute to declare rules of their own, and it must be present
    at run time for reflection over a catalog to work. Note it is deliberately NOT needed for
    the analyzers to see the rules — §7.2 matches on the fully qualified metadata name, which
    survives even when [DiagnosticRule] degrades to an error type.
  -->
  <PropertyGroup Label="Package">
    <PackageId>DiagnosticCatalog</PackageId>
    <DevelopmentDependency>false</DevelopmentDependency>
    <Title>DiagnosticCatalog</Title>
    <Description>Marker attributes for declaring analyzer diagnostic rules as strongly referenced constants, so that SuppressMessageAttribute takes compile-checked references instead of magic strings. Ships the DCAT analyzers and code fixes alongside them, so referencing any catalogue built on this foundation is enough to have your suppressions checked and offered a fix.</Description>
    <PackageTags>roslyn;analyzers;diagnostics;suppressmessage;code-analysis;static-analysis;catalog</PackageTags>
    <PackageReadmeFile>README.en.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Reefact</Authors>
    <Copyright>Copyright (c) Reefact</Copyright>
    <PackageProjectUrl>https://github.com/Reefact/diagnostic-catalog</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.en.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The analyzers ride in this package, beside the attributes (ADR-0037). They are separate PROJECTS —
    an analyzer assembly must be netstandard2.0 for the host compiler to load it, and RS1022 bans
    Workspaces types from it, which is why the code fixes are a third — but they are not separate
    PACKAGES: every catalogue already depends on this one and may not hide it, so shipping the checks
    here is what makes "referencing a catalogue means being checked" a property of the dependency graph
    rather than of thirteen references somebody has to remember.

    analyzers/dotnet/cs/, never lib/. An assembly in lib/ would be compiled against and would become a
    runtime dependency of the consuming application, which docs §16 forbids in its opening line.
    IncludeBuildOutput stays true here, unlike the analyzer project that used to pack itself: this
    package genuinely has a lib/, because DiagnosticCatalog.dll is the one assembly a consumer compiles
    against.

    The pdbs travel beside their assemblies rather than in the symbol package, so anyone debugging an
    analyzer inside a compiler host finds them where the host looks.
  -->
  <ItemGroup>
    <None Include="$(AnalyzersOutputPath)DiagnosticCatalog.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(AnalyzersOutputPath)DiagnosticCatalog.Analyzers.pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(CodeFixesOutputPath)DiagnosticCatalog.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(CodeFixesOutputPath)DiagnosticCatalog.CodeFixes.pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- The released list of diagnostics, at the package root: a consumer deciding whether to upgrade
         reads it without unpacking the analyzer. -->
    <None Include="..\DiagnosticCatalog.Analyzers\AnalyzerReleases.Shipped.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!--
    Build order, not a code dependency. ReferenceOutputAssembly="false" means nothing here compiles
    against the analyzers — this package's own assembly is the attributes and nothing else — but the
    projects are built before this one, so the DLLs packed above exist.

    The tempting alternative is to pack them by path with no reference at all. It works under
    tools/packaging/pack.sh, which packs without rebuilding after a full solution build, and silently
    produces a package with no analyzers in it for anyone running a bare `dotnet pack`.

    The reference runs THIS WAY ROUND on purpose. DiagnosticCatalog.Analyzers deliberately carries no
    reference back: §7.2 requires the marker to be matched by its fully qualified metadata name, so the
    analyzer never needs the attribute type, and depending on it would tempt an implementation into the
    SymbolEqualityComparer shortcut that breaks a catalogue embedding its own attribute.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DiagnosticCatalog.Analyzers\DiagnosticCatalog.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <AnalyzersOutputPath>$(MSBuildThisFileDirectory)..\DiagnosticCatalog.Analyzers\bin\$(Configuration)\netstandard2.0\</AnalyzersOutputPath>
    <CodeFixesOutputPath>$(MSBuildThisFileDirectory)..\DiagnosticCatalog.CodeFixes\bin\$(Configuration)\netstandard2.0\</CodeFixesOutputPath>
  </PropertyGroup>

  <!--
    Guards the shape of this assembly's public API: renaming DiagnosticRuleAttribute or moving
    it out of the DiagnosticCatalog namespace fails the build (RS0016/RS0017) instead of passing
    as a review oversight. Both are major-version triggers.

    Scope note — PublicAPI.*.txt records type and member signatures only. It does NOT cover
    sealedness, AttributeUsage, applied attributes (see the [Conditional] constraint in
    DiagnosticRuleAttribute.cs), or the mandatory Id/Category member names. Those last belong to
    the structural contract imposed on catalog authors and are enforced by DCAT0003/DCAT0004 in
    DiagnosticCatalog.Analyzers, not here.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
