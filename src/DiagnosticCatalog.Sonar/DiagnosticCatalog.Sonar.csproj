<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <AssemblyName>DiagnosticCatalog.Sonar</AssemblyName>
    <RootNamespace>DiagnosticCatalog.Sonar</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    This catalogue ships on the 'sonar' train, which versions independently of the foundation so it
    can follow SonarSource's releases without dragging anything else along. Declaring the train here is the
    whole membership (Directory.Build.targets); it is also what makes the project packable, what gives
    it an embedded SBOM, and what puts the icon on the package.
  -->
  <PropertyGroup>
    <ReleaseTrain>sonar</ReleaseTrain>
  </PropertyGroup>
  <PropertyGroup Label="Package">
    <PackageId>DiagnosticCatalog.Sonar</PackageId>
    <DevelopmentDependency>false</DevelopmentDependency>
    <Title>DiagnosticCatalog.Sonar</Title>
    <Description>The SonarAnalyzer.CSharp rules as strongly referenced constants, so that SuppressMessageAttribute takes compile-checked references instead of magic strings. Ids and categories are read from the analyzers' own DiagnosticDescriptor instances. Unofficial; not affiliated with or endorsed by SonarSource.</Description>
    <PackageTags>roslyn;analyzers;diagnostics;suppressmessage;sonar;sonaranalyzer;code-analysis;catalog</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Reefact</Authors>
    <Copyright>Copyright (c) Reefact</Copyright>
    <PackageProjectUrl>https://github.com/Reefact/diagnostic-catalog</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    A PACKAGE reference, not a project one. The foundation rides the 'lib' train and this catalogue
    rides its own, so packing against the project would stamp a dependency on a lib version that was
    never published, and every consumer's restore would fail with NU1102 on an immutable artifact
    (ADR-0007).

    Version-less, so it resolves from Directory.Packages.props — where moving every catalogue onto a
    new foundation is one deliberate edit rather than three.

    NOT PrivateAssets="all": the foundation must reach whoever consumes this catalogue. They need
    [DiagnosticRule] resolvable to declare rules of their own, and present at run time for reflection
    over a catalogue to work (specification §16.1).
  -->
  <ItemGroup>
    <PackageReference Include="DiagnosticCatalog" />
  </ItemGroup>

</Project>
