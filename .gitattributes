# Snapshot files must keep LF line endings on every platform. Verify 31.21+ rejects
# verified files that contain a carriage return (it no longer normalizes them), so
# without this rule a Windows CI runner checks *.verified.* out as CRLF (core.autocrlf)
# and every snapshot test fails on windows-latest.
#
# Declared before the first snapshot test exists, on purpose: the failure it prevents is
# Windows-only and reads as a mysterious mismatch rather than as a line-ending problem.
#
# Scope is intentionally narrow: the repository otherwise leaves line-ending and charset
# handling untouched (see .editorconfig).
*.verified.* text eol=lf
*.received.* text eol=lf

# Generated catalog sources are committed, regenerated by the nightly sync, and read back
# as text by the tests. Pinning them to LF keeps the committed artifact byte-stable across
# platforms: without it, regenerating on a Windows checkout rewrites every line and turns a
# rule diff — the thing a reviewer must actually read — into a whole-file diff that is
# nothing but line endings.
#
# This is NOT what makes the tests pass. GeneratedCatalogSourceTests normalises line endings
# when it reads a file, precisely so that no test depends on how git checked it out; that
# normalisation stays the mechanism, and it also covers a file regenerated locally, which an
# attribute cannot reach. This rule governs what lands in the repository, not what the tests
# tolerate — the two are deliberately independent.
#
# The files are LF in the object store today, so this changes nothing now. It is declared to
# keep them that way.
*.g.cs text eol=lf
